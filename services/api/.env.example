# ==============================================================================
# 전국 지자체 AI 행정혁신 정책연구 플랫폼 백엔드 환경변수 예시 (.env.example)
# 이 파일을 복사하여 .env 파일을 생성한 뒤 실제 키 값을 입력하세요.
# 주의: .env 파일은 깃허브 등 공개 저장소에 절대 업로드하지 마세요.
# ==============================================================================

# 데이터베이스 연결 URL (기본값: 로컬 SQLite 파일)
DATABASE_URL=sqlite:///./ai_local_research.db

# Groq 초고속 AI LPU API 키 (https://console.groq.com 에서 발급)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# 외부 추가 AI API 키 (선택사항)
XAI_API_KEY=
OPENAI_API_KEY=

# 보안 및 JWT 마스터 비밀키 (임의의 안전한 난수 문자열로 변경 권장)
SECRET_KEY=change-this-to-a-secure-random-secret-key
